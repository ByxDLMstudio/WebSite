async function getAnswerFromAI(promptText, maxTokens = 512, temp = 0.7) {
    const response = await fetch("https://dlmveloper-chatsolade.hf.space/api/predict", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
            data: [promptText, maxTokens, temp]
        })
    });
    
    const result = await response.json();
    console.log(result.data[0]);
    return result.data[0];
}
